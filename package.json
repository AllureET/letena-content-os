{
  "name": "letena-content-os",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "migrate": "node packages/db/src/migrate.mjs",
    "seed": "node packages/db/src/seed.mjs",
    "seed:demo": "LCOS_DEMO=1 node packages/db/src/seed.mjs",
    "api": "node apps/api/src/server.mjs",
    "demo": "node scripts/demo.mjs",
    "test": "node --test packages/*/test/*.test.mjs apps/api/test/*.test.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}
